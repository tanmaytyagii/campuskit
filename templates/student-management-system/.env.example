# Copy this file to .env to change how the app runs. .env is never committed (see .gitignore).
# Every setting is optional: the defaults below are what the app uses without a .env file.

# The key that signs session cookies. Leave it empty and the app creates a random one in
# instance/secret_key. Set your own only for a deployment, and never share it.
SECRET_KEY=

# Where the app listens. 127.0.0.1 means only this computer can open it. Another value lets
# other computers open the app, which has no login: read the README's security notes first.
HOST=127.0.0.1
PORT=5000

# Where the database file is. Empty means instance/students.db.
DATABASE_PATH=

# 1 shows detailed error pages and reloads the app when you change the code. The app refuses
# it unless HOST is 127.0.0.1 or localhost, because the debugger can run any code.
FLASK_DEBUG=0
