{
  "name": "@campuskit/template-engine",
  "version": "2.0.0",
  "private": true,
  "description": "Safe, typed project generation for CampusKit: option validation, designated-location substitution and ZIP packaging.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/zod.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
